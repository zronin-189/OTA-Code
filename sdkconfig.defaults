# =============================================================================
# ESP32-S3-N16R8 CẤU HÌNH PHẦN CỨNG & CHỨC NĂNG (ESP-IDF)
# =============================================================================

# --- 1. Flash 16MB & Chế độ DIO ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- 2. Bảng phân vùng Dual OTA 16MB ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- 3. Cơ chế Bootloader Rollback an toàn ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- 4. Bật 8MB PSRAM Octal SPI ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# --- 5. Console Configuration (UART0 via CH343 / CH9102 + Secondary USB Serial/JTAG) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# --- 6. FreeRTOS & Bộ nhớ Stack ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LWIP_TCP_WND_DEFAULT=14400
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# --- 7. Bluetooth BLE (Bluedroid) & Wi-Fi Coexistence ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GAP_BLE_ENABLE=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=y
CONFIG_BT_BLE_42_SCAN_EN=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- 8. MbedTLS & HTTPS Buffers (TLS 1.2 Stable) ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
# CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS is not set
# CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS is not set

# --- 10. Disable IPv6 to prevent dual-stack socket issues ---
CONFIG_LWIP_IPV6=n


